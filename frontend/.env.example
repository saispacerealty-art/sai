# Copy to .env.local (git-ignored). Only PUBLIC values belong here —
# anything prefixed VITE_ ends up in the browser bundle.
#
# Local dev: values printed by `npx supabase start` / `npx supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key

# NEVER put these in any VITE_ variable or commit them:
#   SUPABASE_SERVICE_ROLE_KEY  -> Edge Function secrets / local scripts only
#   encryption keys            -> live in Supabase Vault only
