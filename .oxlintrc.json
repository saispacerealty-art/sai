{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],

    "jsx-a11y/control-has-associated-label": "off",
    "jsx-a11y/no-autofocus": "off",
    "react/no-danger": "error",
    "react/jsx-no-script-url": "error",
    "react/jsx-no-target-blank": "error",
    "no-eval": "error",
    "no-new-func": "error",
    "no-restricted-properties": ["error",
      { "property": "innerHTML", "message": "XSS risk: render with React instead." },
      { "property": "outerHTML", "message": "XSS risk: render with React instead." },
      { "property": "insertAdjacentHTML", "message": "XSS risk: render with React instead." },
      { "object": "document", "property": "write", "message": "XSS risk." },
      { "property": "bindPopup", "message": "Leaflet popups take HTML strings; pass a DOM node built with textContent, or render via React." },
      { "property": "bindTooltip", "message": "Leaflet tooltips take HTML strings; pass a DOM node built with textContent." }
    ],
    "no-restricted-globals": ["error", "localStorage", "sessionStorage"]
  }
}
