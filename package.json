{
  "name": "sai-space-crm-workspace",
  "private": true,
  "description": "Shortcuts only. The website lives in frontend/, the Supabase server code in backend/; each has its own package.json.",
  "scripts": {
    "install:all": "npm ci --prefix frontend && npm ci --prefix backend",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint && npm --prefix backend run lint",
    "typecheck": "npm --prefix frontend run typecheck",
    "csp": "npm --prefix frontend run csp --",
    "db:start": "npm --prefix backend run db:start",
    "db:reset": "npm --prefix backend run db:reset",
    "db:push": "npm --prefix backend run db:push",
    "db:seed": "npm --prefix backend run db:seed",
    "config:push": "npm --prefix backend run config:push",
    "functions": "npm --prefix backend run functions",
    "functions:deploy": "npm --prefix backend run functions:deploy",
    "logins": "npm --prefix backend run logins",
    "create-owner": "npm --prefix backend run create-owner",
    "test:db": "npm --prefix backend run test:db",
    "test:e2e": "npm --prefix backend run test:e2e"
  }
}
