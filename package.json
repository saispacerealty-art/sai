{
  "name": "sai-space-crm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --level warning",
    "preview": "vite preview",
    "test:db": "node tests/db/01-foundation.test.mjs && node tests/db/02-workflow.test.mjs && node tests/db/03-rotation.test.mjs && node tests/db/04-totp-mfa.test.mjs",
    "test:e2e": "node --env-file=.env.scripts.local tests/e2e/api.test.mjs && node --env-file=.env.scripts.local tests/e2e/realtime.test.mjs && node --env-file=.env.scripts.local tests/e2e/totp-mfa.test.mjs",
    "db:seed": "node --env-file=.env.scripts.local scripts/seed-dev.mjs",
    "functions": "supabase functions serve --env-file supabase/functions/.env",
    "logins": "node scripts/dev-logins.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "read-excel-file": "^9.3.10",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "supabase": "^2.118.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
